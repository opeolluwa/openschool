# Lifetime of access tokens, in minutes. The app converts this to seconds.
ACCESS_TOKEN_TTL_IN_MINUTES=120

# Comma-separated browser origins allowed by CORS and CSRF checks. Required.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5600,http://0.0.0.0:8000

# Deprecated and ignored. Use BODY_LIMIT_MEGA_BYTES.
BODY_LIMIT_MB=25
# Maximum request body size, in mebibytes.
BODY_LIMIT_MEGA_BYTES=25

# Default cache entry lifetime, in seconds.
CACHE_TTL_IN_SECONDS=600

DATABASE_HOST=postgres
DATABASE_NAME=openschool
DATABASE_PASSWORD=openschool
DATABASE_PORT=5432
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
DATABASE_USER=openschool

# Port for `just openapi-preview` (scripts/openapi/preview.mjs). Defaults to 5859.
DOCS_PORT=5859

# The From identity stamped on outgoing mail. The API provider rejects any
# domain the account has not verified, so set this to a domain your Mailtrap
# account owns when EMAIL_PROVIDER=mailtrap.
EMAIL_FROM_ADDRESS=accounts@openschool.com
EMAIL_FROM_NAME="OpenSchool Accounts"
# Which transport delivers mail. Either smtp or mailtrap; only the selected
# provider's credentials below are required, so you can leave the other set
# empty. Both go through the same `emails` queue, so switching needs no redeploy
# of the worker logic.
EMAIL_PROVIDER=smtp
EMAIL_SUPPORT_FROM_ADDRESS=support@openschool.com
EMAIL_SUPPORT_FROM_NAME="OpenSchool Support"
EMAIL_TRANSACTIONS_FROM_ADDRESS=transactions@openschool.com
EMAIL_TRANSACTIONS_FROM_NAME="OpenSchool Transactions"

# dev/development, test/testing, or prod/production. Controls log level, some
# defaults, and production-only validation such as refusing SMTP_TLS_MODE=none.
ENVIRONMENT=dev

# Directory for generated export files.
EXPORT_PATH=tmp

# Which provider stores uploaded files. Either imagekit or s3; only the
# selected provider's credentials below are required.
FILE_STORAGE_PROVIDER=imagekit

# Public storefront/frontend origin.
FRONTEND_URL=http://localhost:7008

# ImageKit destination folder. Leave empty to use the account default.
IMAGEKIT_FOLDER=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
# ImageKit upload endpoint. The default points at the local mock stack.
IMAGEKIT_UPLOAD_URL=http://mmock:8083/api/v1/files/upload

# Reserved for JWT signing. Auth state is not wired into the running app yet,
# so the current build does not read this value.
JWT_SIGNING_KEY=dev-only-placeholder-key-32chars-min-0123456789abcdef

# Comma-separated Kafka bootstrap servers. Required when QUEUE_DRIVER=kafka.
KAFKA_BROKERS=127.0.0.1:9092
# Kafka consumer group id.
KAFKA_CONSUMER_GROUP=asterisk-events

# Reserved. The app currently derives its log level from ENVIRONMENT.
LOG_LEVEL=info

# Base delay for exponential backoff between delivery attempts, in milliseconds.
MAILMAN_BACKOFF_MILLIS=2000
# Maximum number of messages the Kafka consumer processes concurrently.
MAILMAN_CONCURRENCY=100
# Queue event the mailman subscribes to. Leave as send-email unless the
# producer publishes a different event name.
MAILMAN_EVENT=send-email
# How long a worker holds a Redis job lock before a stalled check may reclaim it.
MAILMAN_LOCK_DURATION_SECS=90
# How many times a queued email may be attempted before it is dropped.
MAILMAN_MAX_ATTEMPTS=5
# Wall-clock ceiling for a single delivery, in seconds.
MAILMAN_SEND_DEADLINE_SECS=20

# Required when EMAIL_PROVIDER=mailtrap. The token is the sending API token,
# not the SMTP credentials below.
MAILTRAP_API_TOKEN=
MAILTRAP_BASE_URL=https://send.api.mailtrap.io/api/send

# Maximum number of PostgreSQL pool connections. Required.
MAX_DB_CONNECTIONS=10

# Base URL used by the OpenAPI preview's "Try it out" requests. Defaults to
# http://localhost:8000.
OPENAPI_API_URL=http://localhost:8000

# Paystack credentials and endpoints. The API key and secret are required.
PAYSTACK_API_KEY=
PAYSTACK_API_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co/transaction/initialize
PAYSTACK_VERIFY_BASE_URL=https://api.paystack.co/transaction/verify

# HTTP port the app listens on. docker-compose overrides this to 8000.
# `just preview-emails` also reads it as its bind port.
PORT=5006

# Queue backing the mailman: redis (default) or kafka. Only the selected
# driver's settings are required.
QUEUE_DRIVER=redis

# Per-hour auth request limit.
RATE_LIMIT_AUTH_PER_HOUR=30
# Per-minute auth request limit.
RATE_LIMIT_AUTH_PER_MINUTE=5
# Burst allowance for the per-second rate limit.
RATE_LIMIT_BURST=10
# Maximum number of rate-limit keys kept in memory.
RATE_LIMIT_MAX_KEYS=100000
# Per-hour OTP request limit.
RATE_LIMIT_OTP_PER_HOUR=10
# Per-minute OTP request limit.
RATE_LIMIT_OTP_PER_MINUTE=2
# Sustained per-minute request limit.
RATE_LIMIT_PER_MINUTE=50
# Per-second request limit.
RATE_LIMIT_RPS=5

# Redis connection used by the app and its mailman. Required.
REDIS_CONNECTION_URL=redis://redis:6379
# Fallback alias for the standalone mailman binary only; the app ignores it.
# Keep it equal to REDIS_CONNECTION_URL unless the binary needs a separate broker.
REDIS_URL=redis://redis:6379

# Lifetime of refresh tokens, in minutes. The app converts this to seconds.
REFRESH_TOKEN_TTL_IN_MINUTES=420

# Per-request timeout, in seconds.
REQUESTS_TIME_OUT_SECS=12

# AWS S3 settings, used when FILE_STORAGE_PROVIDER=s3. Set S3_ENDPOINT for an
# S3-compatible service such as MinIO, and S3_PUBLIC_BASE_URL when objects are
# served through a CDN or a custom domain.
S3_ACCESS_KEY_ID=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=
S3_PUBLIC_BASE_URL=
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# SMTP settings, used when EMAIL_PROVIDER=smtp. The app reads SMTP_AUTH_*;
# the standalone mailman binary reads SMTP_USERNAME/SMTP_PASSWORD instead.
# Leave the credentials empty for a local sink such as maildev, which has no
# authentication. SMTP_PORT 1025 and SMTP_TLS_MODE=none match maildev;
# production generally uses port 587 with STARTTLS.
SMTP_AUTH_PASSWORD=
SMTP_AUTH_USERNAME=
SMTP_HOST=maildev
SMTP_PASSWORD=
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_USERNAME=

# Directory for uploaded files.
UPLOAD_PATH=tmp
